<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="https://irihi.tech/mafia"
             xmlns:demo="https://irihi.tech/demo"
             xmlns:vm="clr-namespace:Irihi.Mafia.Demo.ViewModels"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="Irihi.Mafia.Demo.Views.PopupPage"
             x:DataType="vm:PopupPageViewModel"
             Theme="{DynamicResource ScrollPage}">
    <Panel>
        <StackPanel Spacing="32">
            <demo:GalleryBlock
                Classes="PageStart"
                Title="{demo:Translate {x:Static demo:LanguageManager+Keys.Popup_Title}}"
                Summary="{demo:Translate {x:Static demo:LanguageManager+Keys.Popup_Desc}}" />

            <demo:GalleryBlock
                Title="{demo:Translate {x:Static demo:LanguageManager+Keys.Popup_Placement}}">
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*,*"
                      ColumnSpacing="8" RowSpacing="8">
                    <Grid.Styles>
                        <Style Selector="Button">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </Style>
                    </Grid.Styles>
                    <Button Grid.Row="0" Grid.Column="1" Content="Top"
                            Command="{Binding OpenPopupCommand}" CommandParameter="Top" />
                    <Button Grid.Row="1" Grid.Column="1" Content="Center"
                            Command="{Binding OpenPopupCommand}" CommandParameter="Center" />
                    <Button Grid.Row="2" Grid.Column="1" Content="Bottom"
                            Command="{Binding OpenPopupCommand}" CommandParameter="Bottom" />
                    <Button Grid.Row="1" Grid.Column="0" Content="Left"
                            Command="{Binding OpenPopupCommand}" CommandParameter="Left" />
                    <Button Grid.Row="1" Grid.Column="2" Content="Right"
                            Command="{Binding OpenPopupCommand}" CommandParameter="Right" />
                    <Button Grid.Row="0" Grid.Column="2" Content="FullScreen"
                            Command="{Binding OpenPopupCommand}" CommandParameter="FullScreen" />
                </Grid>
            </demo:GalleryBlock>

            <demo:GalleryBlock
                Classes="Origin"
                Title="{demo:Translate {x:Static demo:LanguageManager+Keys.Popup_Options}}">
                <StackPanel>
                    <CheckBox Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Popup_Modal}}" IsChecked="{Binding IsModal}" />
                    <CheckBox Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Popup_LightDismiss}}" IsChecked="{Binding IsLightDismiss}" />
                </StackPanel>
            </demo:GalleryBlock>

            <demo:GalleryBlock
                Title="{demo:Translate {x:Static demo:LanguageManager+Keys.Popup_Inheritance}}"
                Summary="{demo:Translate {x:Static demo:LanguageManager+Keys.Popup_Inheritance_Desc}}">
                <Button Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Popup_InheritedButton}}"
                        Command="{Binding OpenInheritedPopupCommand}"
                        Classes="Primary" />
            </demo:GalleryBlock>
        </StackPanel>

        <m:Popup IsOpen="{Binding IsPopupOpen}"
                 IsModal="{Binding IsModal}"
                 IsLightDismissEnabled="{Binding IsLightDismiss}"
                 Placement="{Binding PopupPlacement}">
            <Border Background="{DynamicResource TDBgColorContainer}"
                    CornerRadius="12"
                    Padding="24"
                    MinHeight="200">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding PopupTitle}" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="{demo:Translate {x:Static demo:LanguageManager+Keys.Popup_DismissHint}}" TextWrapping="Wrap" />
                    <Button Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Popup_Close}}"
                            Command="{Binding ClosePopupCommand}"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </m:Popup>

        <Panel m:Popup.Placement="Bottom">
            <m:Popup IsOpen="{Binding IsInheritedPopupOpen}"
                     IsModal="True"
                     IsLightDismissEnabled="True">
                <Border Background="{DynamicResource TDBgColorContainer}"
                        CornerRadius="12"
                        Padding="24"
                        MinHeight="150">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Inherited: Bottom" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Placement inherited from parent Panel via m:Popup.Placement."
                                   TextWrapping="Wrap" />
                        <Button Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Popup_Close}}"
                                Command="{Binding CloseInheritedPopupCommand}"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </m:Popup>
        </Panel>
    </Panel>
</ContentPage>