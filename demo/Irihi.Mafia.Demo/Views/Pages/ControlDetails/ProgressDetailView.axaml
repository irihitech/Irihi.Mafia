<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="https://irihi.tech/mafia"
             x:Class="Irihi.Mafia.Demo.Views.Pages.ControlDetails.ProgressDetailView">
    <ScrollViewer>
        <StackPanel Spacing="12" Margin="16,16,16,24">
            <TextBlock Text="Progress 进度条" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="支持线形进度条和圆形进度条。多种语义颜色：默认、成功、警告、错误。" 
                       TextWrapping="Wrap" FontSize="14"
                       Foreground="{DynamicResource TDFontGyColor}" />

            <m:Divider />

            <TextBlock Text="线形进度条" FontSize="16" FontWeight="SemiBold" />
            <ProgressBar Value="66" Maximum="100" />
            <ProgressBar Value="66" Maximum="100" Classes="Success" />
            <ProgressBar Value="30" Maximum="100" Classes="Warning" />
            <ProgressBar Value="88" Maximum="100" Classes="Error" />

            <TextBlock Text="圆形进度条" FontSize="16" FontWeight="SemiBold" />
            <WrapPanel>
                <ProgressBar Value="66" Maximum="100"
                             Theme="{DynamicResource CircleProgressBar}" Margin="0,0,16,0" />
                <ProgressBar Value="30" Maximum="100"
                             Theme="{DynamicResource CircleProgressBar}" Classes="Warning" Margin="0,0,16,0" />
                <ProgressBar Value="88" Maximum="100"
                             Theme="{DynamicResource CircleProgressBar}" Classes="Error" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
