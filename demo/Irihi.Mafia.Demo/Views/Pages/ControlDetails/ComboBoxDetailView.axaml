<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="https://irihi.tech/mafia"
             xmlns:vm="clr-namespace:Irihi.Mafia.Demo.ViewModels.ControlDetails"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:DataType="vm:ComboBoxDetailViewModel"
             x:Class="Irihi.Mafia.Demo.Views.Pages.ControlDetails.ComboBoxDetailView">
    <ScrollViewer>
        <StackPanel Spacing="4">
            <TextBlock Text="ComboBox 下拉选择" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TDFontGyColor}" />
            <TextBlock Text="触控优化的下拉选择控件。使用 Mafia Popup 实现底部弹出面板，支持占位文本、禁用态等。"
                       TextWrapping="Wrap" FontSize="14"
                       Foreground="{DynamicResource TDFontGyColor}" />

            <m:Divider />

            <TextBlock Text="基础用法" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TDFontGyColor}" />
            <m:ComboBox SelectedIndex="0">
                <m:ComboBoxItem>选项一</m:ComboBoxItem>
                <m:ComboBoxItem>选项二</m:ComboBoxItem>
                <m:ComboBoxItem>选项三</m:ComboBoxItem>
                <m:ComboBoxItem>选项四</m:ComboBoxItem>
                <m:ComboBoxItem>选项五</m:ComboBoxItem>
            </m:ComboBox>

            <TextBlock Text="带占位文本" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TDFontGyColor}" />
            <m:ComboBox PlaceholderText="请选择城市">
                <m:ComboBoxItem>北京</m:ComboBoxItem>
                <m:ComboBoxItem>上海</m:ComboBoxItem>
                <m:ComboBoxItem>广州</m:ComboBoxItem>
                <m:ComboBoxItem>深圳</m:ComboBoxItem>
                <m:ComboBoxItem>杭州</m:ComboBoxItem>
            </m:ComboBox>

            <TextBlock Text="默认选中" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TDFontGyColor}" />
            <m:ComboBox SelectedIndex="2">
                <m:ComboBoxItem>小号</m:ComboBoxItem>
                <m:ComboBoxItem>中号</m:ComboBoxItem>
                <m:ComboBoxItem>大号</m:ComboBoxItem>
                <m:ComboBoxItem>加大号</m:ComboBoxItem>
            </m:ComboBox>

            <TextBlock Text="禁用态" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TDFontGyColor}" />
            <m:ComboBox SelectedIndex="0" IsEnabled="False">
                <m:ComboBoxItem>不可选</m:ComboBoxItem>
                <m:ComboBoxItem>不可选</m:ComboBoxItem>
            </m:ComboBox>

            <TextBlock Text="禁用态 + 占位文本" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TDFontGyColor}" />
            <m:ComboBox PlaceholderText="已禁用" IsEnabled="False">
                <m:ComboBoxItem>选项一</m:ComboBoxItem>
                <m:ComboBoxItem>选项二</m:ComboBoxItem>
            </m:ComboBox>

            <TextBlock Text="多项长列表" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TDFontGyColor}" />
            <m:ComboBox PlaceholderText="选择省份" SelectedIndex="0">
                <m:ComboBoxItem>北京市</m:ComboBoxItem>
                <m:ComboBoxItem>上海市</m:ComboBoxItem>
                <m:ComboBoxItem>天津市</m:ComboBoxItem>
                <m:ComboBoxItem>重庆市</m:ComboBoxItem>
                <m:ComboBoxItem>河北省</m:ComboBoxItem>
                <m:ComboBoxItem>山西省</m:ComboBoxItem>
                <m:ComboBoxItem>辽宁省</m:ComboBoxItem>
                <m:ComboBoxItem>吉林省</m:ComboBoxItem>
                <m:ComboBoxItem>黑龙江省</m:ComboBoxItem>
                <m:ComboBoxItem>江苏省</m:ComboBoxItem>
                <m:ComboBoxItem>浙江省</m:ComboBoxItem>
                <m:ComboBoxItem>安徽省</m:ComboBoxItem>
                <m:ComboBoxItem>福建省</m:ComboBoxItem>
                <m:ComboBoxItem>江西省</m:ComboBoxItem>
                <m:ComboBoxItem>山东省</m:ComboBoxItem>
                <m:ComboBoxItem>河南省</m:ComboBoxItem>
                <m:ComboBoxItem>湖北省</m:ComboBoxItem>
                <m:ComboBoxItem>湖南省</m:ComboBoxItem>
                <m:ComboBoxItem>广东省</m:ComboBoxItem>
                <m:ComboBoxItem>四川省</m:ComboBoxItem>
                <m:ComboBoxItem>贵州省</m:ComboBoxItem>
                <m:ComboBoxItem>云南省</m:ComboBoxItem>
                <m:ComboBoxItem>陕西省</m:ComboBoxItem>
                <m:ComboBoxItem>甘肃省</m:ComboBoxItem>
                <m:ComboBoxItem>青海省</m:ComboBoxItem>
            </m:ComboBox>

            <TextBlock Text="Cell 风格（Description + Note + InnerLeftContent）" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TDFontGyColor}" />
            <m:ComboBox SelectedIndex="1"
                        Description="用于设置首选语言"
                        Note="辅助信息">
                <m:ComboBoxItem>简体中文</m:ComboBoxItem>
                <m:ComboBoxItem>English</m:ComboBoxItem>
                <m:ComboBoxItem>日本語</m:ComboBoxItem>
            </m:ComboBox>

            <m:Divider />

            <TextBlock Text="MVVM 数据绑定" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TDFontGyColor}" />

            <TextBlock Text="语言选择（ItemsSource + SelectedItem）" FontSize="14"
                       Foreground="{DynamicResource TDFontGyColor}" />
            <m:ComboBox ItemsSource="{Binding Languages}"
                        SelectedItem="{Binding SelectedLanguage}"
                        Description="数据驱动的下拉选择"
                        Note="双向绑定">
            </m:ComboBox>
            <TextBlock Text="{Binding SelectedLanguage, StringFormat='已选: {0}'}"
                       FontSize="14"
                       Foreground="{DynamicResource TDFontGyColor}" />

            <TextBlock Text="尺码选择（ItemsSource + SelectedIndex）" FontSize="14"
                       Foreground="{DynamicResource TDFontGyColor}" />
            <m:ComboBox ItemsSource="{Binding Sizes}"
                        SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                        PlaceholderText="请选择尺码">
            </m:ComboBox>
            <TextBlock Text="{Binding SelectedIndex, StringFormat='SelectedIndex: {0}'}"
                       FontSize="14"
                       Foreground="{DynamicResource TDFontGyColor}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
