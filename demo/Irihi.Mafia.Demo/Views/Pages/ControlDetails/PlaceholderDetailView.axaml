<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Irihi.Mafia.Demo"
             x:Class="Irihi.Mafia.Demo.Views.Pages.ControlDetails.PlaceholderDetailView">
    <ScrollViewer>
        <StackPanel Spacing="12" Margin="16,16,16,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="🚧" FontSize="48" HorizontalAlignment="Center" />
            <TextBlock Text="{Translate {x:Static local:LanguageManager+Keys.Placeholder_Title}}" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Translate {x:Static local:LanguageManager+Keys.Placeholder_Desc}}" 
                       TextWrapping="Wrap" FontSize="14"
                       Foreground="{DynamicResource TDFontGyColor}"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
