<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Irihi.Mafia.Demo"
             xmlns:m="https://irihi.tech/mafia"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="Irihi.Mafia.Demo.Views.Pages.ControlDetails.StickyPanelDetailView">
    <DockPanel>
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="16,16,16,0">
            <TextBlock Text="{Translate {x:Static local:LanguageManager+Keys.StickyPanel_Title}}" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="{Translate {x:Static local:LanguageManager+Keys.StickyPanel_Desc}}"
                       TextWrapping="Wrap" />
            <m:Divider />
        </StackPanel>

        <!-- Content with sticky headers -->
        <ScrollViewer>
            <m:StickyPanel>
                <!-- Section 1 -->
                <TextBlock m:StickyPanel.StickyLevel="1"
                           Text="{Translate {x:Static local:LanguageManager+Keys.StickyPanel_Section_Group1}}"
                           FontSize="16" FontWeight="SemiBold" Padding="16,12,16,8"
                           Foreground="{DynamicResource TDFontBodyColor}"
                           Background="{DynamicResource TDBgColorContainer}" />

                <Border Padding="16,8,16,8">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Item 1.1" />
                        <TextBlock Text="Item 1.2" />
                        <TextBlock Text="Item 1.3" />
                        <TextBlock Text="Item 1.4" />
                        <TextBlock Text="Item 1.5" />
                        <TextBlock Text="Item 1.6" />
                        <TextBlock Text="Item 1.7" />
                        <TextBlock Text="Item 1.8" />
                        <TextBlock Text="Item 1.9" />
                        <TextBlock Text="Item 1.10" />
                    </StackPanel>
                </Border>

                <!-- Section 2 -->
                <TextBlock m:StickyPanel.StickyLevel="1"
                           Text="{Translate {x:Static local:LanguageManager+Keys.StickyPanel_Section_Group2}}"
                           FontSize="16" FontWeight="SemiBold" Padding="16,12,16,8"
                           Foreground="{DynamicResource TDFontBodyColor}"
                           Background="{DynamicResource TDBgColorContainer}" />

                <Border Padding="16,8,16,8">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Item 2.1" />
                        <TextBlock Text="Item 2.2" />
                        <TextBlock Text="Item 2.3" />
                        <TextBlock Text="Item 2.4" />
                        <TextBlock Text="Item 2.5" />
                        <TextBlock Text="Item 2.6" />
                        <TextBlock Text="Item 2.7" />
                        <TextBlock Text="Item 2.8" />
                        <TextBlock Text="Item 2.9" />
                        <TextBlock Text="Item 2.10" />
                    </StackPanel>
                </Border>

                <!-- Section 3 -->
                <TextBlock m:StickyPanel.StickyLevel="1"
                           Text="{Translate {x:Static local:LanguageManager+Keys.StickyPanel_Section_Group3}}"
                           FontSize="16" FontWeight="SemiBold" Padding="16,12,16,8"
                           Foreground="{DynamicResource TDFontBodyColor}"
                           Background="{DynamicResource TDBgColorContainer}" />

                <Border Padding="16,8,16,8">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Item 3.1" />
                        <TextBlock Text="Item 3.2" />
                        <TextBlock Text="Item 3.3" />
                        <TextBlock Text="Item 3.4" />
                        <TextBlock Text="Item 3.5" />
                        <TextBlock Text="Item 3.6" />
                        <TextBlock Text="Item 3.7" />
                        <TextBlock Text="Item 3.8" />
                        <TextBlock Text="Item 3.9" />
                        <TextBlock Text="Item 3.10" />
                    </StackPanel>
                </Border>

                <!-- Section 4 -->
                <TextBlock m:StickyPanel.StickyLevel="1"
                           Text="{Translate {x:Static local:LanguageManager+Keys.StickyPanel_Section_Group4}}"
                           FontSize="16" FontWeight="SemiBold" Padding="16,12,16,8"
                           Foreground="{DynamicResource TDFontBodyColor}"
                           Background="{DynamicResource TDBgColorContainer}" />

                <Border Padding="16,8,16,8">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Item 4.1" />
                        <TextBlock Text="Item 4.2" />
                        <TextBlock Text="Item 4.3" />
                        <TextBlock Text="Item 4.4" />
                        <TextBlock Text="Item 4.5" />
                        <TextBlock Text="Item 4.6" />
                        <TextBlock Text="Item 4.7" />
                        <TextBlock Text="Item 4.8" />
                        <TextBlock Text="Item 4.9" />
                        <TextBlock Text="Item 4.10" />
                    </StackPanel>
                </Border>

                <!-- Section 5 -->
                <TextBlock m:StickyPanel.StickyLevel="1"
                           Text="{Translate {x:Static local:LanguageManager+Keys.StickyPanel_Section_Group5}}"
                           FontSize="16" FontWeight="SemiBold" Padding="16,12,16,8"
                           Foreground="{DynamicResource TDFontBodyColor}"
                           Background="{DynamicResource TDBgColorContainer}" />

                <Border Padding="16,8,16,8">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Item 5.1" />
                        <TextBlock Text="Item 5.2" />
                        <TextBlock Text="Item 5.3" />
                        <TextBlock Text="Item 5.4" />
                        <TextBlock Text="Item 5.5" />
                        <TextBlock Text="Item 5.6" />
                        <TextBlock Text="Item 5.7" />
                        <TextBlock Text="Item 5.8" />
                        <TextBlock Text="Item 5.9" />
                        <TextBlock Text="Item 5.10" />
                    </StackPanel>
                </Border>

                <!-- Section 6 -->
                <TextBlock m:StickyPanel.StickyLevel="1"
                           Text="{Translate {x:Static local:LanguageManager+Keys.StickyPanel_Section_Group6}}"
                           FontSize="16" FontWeight="SemiBold" Padding="16,12,16,8"
                           Foreground="{DynamicResource TDFontBodyColor}"
                           Background="{DynamicResource TDBgColorContainer}" />

                <Border Padding="16,8,16,24">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Item 6.1" />
                        <TextBlock Text="Item 6.2" />
                        <TextBlock Text="Item 6.3" />
                        <TextBlock Text="Item 6.4" />
                        <TextBlock Text="Item 6.5" />
                        <TextBlock Text="Item 6.6" />
                        <TextBlock Text="Item 6.7" />
                        <TextBlock Text="Item 6.8" />
                        <TextBlock Text="Item 6.9" />
                        <TextBlock Text="Item 6.10" />
                    </StackPanel>
                </Border>
            </m:StickyPanel>
        </ScrollViewer>
    </DockPanel>
</ContentPage>