<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:td="https://irihi.tech/td"
             xmlns:m="https://irihi.tech/mafia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Irihi.Mafia.Demo.Views.Pages.ControlDetails.IconGalleryView">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="24">
            <TextBlock Text="TDesign Icons" FontSize="20" FontWeight="Bold" />

            <StackPanel Spacing="12">
                <TextBlock Text="Outline" FontSize="16" FontWeight="SemiBold" />

                <m:Picker Name="modePicker" SelectedIndex="3" Description="IconMode">
                    <td:IconMode>OutlineSingle</td:IconMode>
                    <td:IconMode>OutlineDouble</td:IconMode>
                    <td:IconMode>FilledDouble</td:IconMode>
                    <td:IconMode>FilledMultiple</td:IconMode>
                </m:Picker>

                <UniformGrid Columns="6" ColumnSpacing="16" RowSpacing="16">
                    <UniformGrid.Styles>
                        <Style Selector=":is(td|TDesignIconBase)">
                            <Setter Property="Mode" Value="{Binding #modePicker.SelectedValue}" />
                        </Style>
                    </UniformGrid.Styles>
                    <td:App />
                    <td:Browse />
                    <td:BrowseOff />
                    <td:Chat />
                    <td:Check />
                    <td:CheckCircle />
                    <td:CheckRectangle />
                    <td:ChevronLeft />
                    <td:ChevronRight />
                    <td:Close />
                    <td:CloseCircle />
                    <td:Home />
                    <td:Link />
                    <td:MenuApplication />
                    <td:MinusCircle />
                    <td:Search />
                    <td:User />
                </UniformGrid>
            </StackPanel>

            <m:Divider Margin="0,8" />

            <StackPanel Spacing="12">
                <TextBlock Text="Fill" FontSize="16" FontWeight="SemiBold" />
                <UniformGrid Columns="6" ColumnSpacing="16" RowSpacing="16">
                    <td:CheckCircleFilled />
                    <td:MinusCircleFilled />
                </UniformGrid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>