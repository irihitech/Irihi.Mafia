<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="https://irihi.tech/mafia"
             xmlns:demo="https://irihi.tech/demo"
             xmlns:vm="clr-namespace:Irihi.Mafia.Demo.ViewModels"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:DataType="vm:PickerPageViewModel"
             x:Class="Irihi.Mafia.Demo.Views.PickerPage"
             Theme="{DynamicResource ScrollPage}">
    <StackPanel Spacing="32">
        <demo:GalleryBlock
            Classes="PageStart"
            Title="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_Title}}"
            Summary="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_Desc}}" />

        <demo:GalleryBlock
            Classes="Origin"
            Title="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_BasicUsage}}">
            <m:CellGroup>
                <m:Picker SelectedIndex="0">
                    <m:PickerItem Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_Option1}}" />
                    <m:PickerItem Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_Option2}}" />
                    <m:PickerItem Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_Option3}}" />
                    <m:PickerItem Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_Option4}}" />
                    <m:PickerItem Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_Option5}}" />
                </m:Picker>
                <m:Picker PlaceholderText="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_Placeholder_City}}">
                    <m:PickerItem>北京</m:PickerItem>
                    <m:PickerItem>上海</m:PickerItem>
                    <m:PickerItem>广州</m:PickerItem>
                    <m:PickerItem>深圳</m:PickerItem>
                    <m:PickerItem>杭州</m:PickerItem>
                </m:Picker>
            </m:CellGroup>
        </demo:GalleryBlock>

        <demo:GalleryBlock
            Classes="Origin"
            Title="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_LongList}}">
            <m:Picker PlaceholderText="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_Placeholder_Province}}" SelectedIndex="0">
                <m:PickerItem>北京市</m:PickerItem>
                <m:PickerItem>上海市</m:PickerItem>
                <m:PickerItem>天津市</m:PickerItem>
                <m:PickerItem>重庆市</m:PickerItem>
                <m:PickerItem>河北省</m:PickerItem>
                <m:PickerItem>山西省</m:PickerItem>
                <m:PickerItem>辽宁省</m:PickerItem>
                <m:PickerItem>吉林省</m:PickerItem>
                <m:PickerItem>黑龙江省</m:PickerItem>
                <m:PickerItem>江苏省</m:PickerItem>
                <m:PickerItem>浙江省</m:PickerItem>
                <m:PickerItem>安徽省</m:PickerItem>
                <m:PickerItem>福建省</m:PickerItem>
                <m:PickerItem>江西省</m:PickerItem>
                <m:PickerItem>山东省</m:PickerItem>
                <m:PickerItem>河南省</m:PickerItem>
                <m:PickerItem>湖北省</m:PickerItem>
                <m:PickerItem>湖南省</m:PickerItem>
                <m:PickerItem>广东省</m:PickerItem>
                <m:PickerItem>四川省</m:PickerItem>
                <m:PickerItem>贵州省</m:PickerItem>
                <m:PickerItem>云南省</m:PickerItem>
                <m:PickerItem>陕西省</m:PickerItem>
                <m:PickerItem>甘肃省</m:PickerItem>
                <m:PickerItem>青海省</m:PickerItem>
            </m:Picker>
        </demo:GalleryBlock>

        <demo:GalleryBlock
            Classes="Origin"
            Title="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_Mvvm}}">
            <StackPanel Spacing="8">
                <TextBlock Text="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_LanguageBinding}}" />
                <m:Picker ItemsSource="{Binding Languages}"
                          SelectedItem="{Binding SelectedLanguage}"
                          Description="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_MvvmDesc}}"
                          Note="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_MvvmNote}}" />
                <TextBlock Text="{Binding SelectedLanguage, StringFormat='已选: {0}'}" />

                <TextBlock Text="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_SizeBinding}}" />
                <m:Picker ItemsSource="{Binding Sizes}"
                          SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                          PlaceholderText="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_Placeholder_Size}}" />
                <TextBlock Text="{Binding SelectedIndex, StringFormat='SelectedIndex: {0}'}" />
            </StackPanel>
        </demo:GalleryBlock>

        <demo:GalleryBlock
            Classes="Origin"
            Title="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_Confirmable}}"
            Summary="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_Confirmable_Desc}}">
            <m:Picker PlaceholderText="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_Placeholder_Select}}" IsConfirmable="True"
                      PopupTitle="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_PopupTitle}}"
                      Description="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_ConfirmDesc}}">
                <m:PickerItem Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_OptionA}}" />
                <m:PickerItem Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_OptionB}}" />
                <m:PickerItem Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_OptionC}}" />
                <m:PickerItem Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_OptionD}}" />
                <m:PickerItem Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Picker_OptionE}}" />
            </m:Picker>
        </demo:GalleryBlock>
    </StackPanel>
</ContentPage>