<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="https://irihi.tech/mafia"
             xmlns:td="https://irihi.tech/td"
             xmlns:demo="https://irihi.tech/demo"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="Irihi.Mafia.Demo.Views.CellPage"
             Theme="{DynamicResource ScrollPage}">
    <StackPanel Spacing="32">
        <demo:GalleryBlock
            Classes="PageStart"
            Title="{demo:Translate {x:Static demo:LanguageManager+Keys.Cell_Title}}"
            Summary="{demo:Translate {x:Static demo:LanguageManager+Keys.Cell_Desc}}" />

        <demo:GalleryBlock
            Classes="Origin"
            Title="{demo:Translate {x:Static demo:LanguageManager+Keys.Cell_Basic}}">
            <m:CellGroup>
                <m:Cell Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Cell_Content}}" />
                <m:Cell Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Cell_Content}}" Classes="Arrow" />
                <m:Cell Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Cell_Required}}" Classes="Arrow" IsRequired="True" />
                <m:Cell Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Cell_Note}}" Classes="Arrow"
                        Note="{demo:Translate {x:Static demo:LanguageManager+Keys.Cell_NoteText}}" />
                <m:Cell Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Cell_LeftIcon}}"
                        InnerLeftContent="{td:TempApp}" />
            </m:CellGroup>
        </demo:GalleryBlock>

        <demo:GalleryBlock
            Classes="Origin"
            Title="{demo:Translate {x:Static demo:LanguageManager+Keys.Cell_Advanced}}">
            <m:CellGroup>
                <m:Cell Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Cell_AdvancedContent}}"
                        Classes="Arrow"
                        Description="{demo:Translate {x:Static demo:LanguageManager+Keys.Cell_AdvancedDesc}}"
                        Note="{demo:Translate {x:Static demo:LanguageManager+Keys.Cell_AdvancedNote}}"
                        InnerLeftContent="{td:TempApp}"
                        InnerRightContent="{td:TempChevronRight}" />
                <m:Cell Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Cell_AdvancedContent}}"
                        Description="{demo:Translate {x:Static demo:LanguageManager+Keys.Cell_AdvancedDesc}}"
                        InnerLeftContent="{td:TempUser}"
                        InnerRightContent="{td:TempChevronLeft}" />
            </m:CellGroup>
        </demo:GalleryBlock>
    </StackPanel>
</ContentPage>