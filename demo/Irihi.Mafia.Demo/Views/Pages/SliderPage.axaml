<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:demo="https://irihi.tech/demo"
             x:Class="Irihi.Mafia.Demo.Views.SliderPage"
             Theme="{DynamicResource ScrollPage}">
    <demo:GalleryBlock
        Classes="PageStart"
        Title="{demo:Translate {x:Static demo:LanguageManager+Keys.Slider_Title}}"
        Summary="{demo:Translate {x:Static demo:LanguageManager+Keys.Slider_Desc}}">
        <StackPanel Spacing="8">
            <Slider Minimum="0" Maximum="100" Value="50" />
            <Slider Minimum="0" Maximum="100" Value="75" />
            <Slider Minimum="0" Maximum="100" Value="25" />
        </StackPanel>
    </demo:GalleryBlock>
</ContentPage>