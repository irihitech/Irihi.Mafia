<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:demo="https://irihi.tech/demo"
             x:Class="Irihi.Mafia.Demo.Views.PlaceholderPage"
             Theme="{DynamicResource ScrollPage}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <demo:GalleryBlock
            Title="{demo:Translate {x:Static demo:LanguageManager+Keys.Placeholder_Title}}"
            Summary="{demo:Translate {x:Static demo:LanguageManager+Keys.Placeholder_Desc}}" />
        <TextBlock Text="🚧" FontSize="48" HorizontalAlignment="Center" />
    </StackPanel>
</ContentPage>