<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="https://irihi.tech/mafia"
             xmlns:demo="https://irihi.tech/demo"
             xmlns:vm="clr-namespace:Irihi.Mafia.Demo.ViewModels"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="Irihi.Mafia.Demo.Views.CalendarPage"
             x:DataType="vm:CalendarPageViewModel"
             Theme="{DynamicResource ScrollPage}">
    <Panel>
        <StackPanel Spacing="32">
            <demo:GalleryBlock
                Classes="PageStart"
                Title="{demo:Translate {x:Static demo:LanguageManager+Keys.Calendar_Title}}"
                Summary="{demo:Translate {x:Static demo:LanguageManager+Keys.Calendar_Desc}}" />

            <demo:GalleryBlock
                Classes="Origin"
                Title="{demo:Translate {x:Static demo:LanguageManager+Keys.Calendar_PagedSingle}}">
                <StackPanel Spacing="8">
                    <m:Calendar SelectedDate="{Binding PagedSingleDate, Mode=TwoWay}" />
                    <TextBlock
                        Text="{Binding PagedSingleDateText, StringFormat='Selected: {0}'}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </demo:GalleryBlock>

            <demo:GalleryBlock
                Classes="Origin"
                Title="{demo:Translate {x:Static demo:LanguageManager+Keys.Calendar_Multiple}}"
                Summary="{demo:Translate {x:Static demo:LanguageManager+Keys.Calendar_Multiple_Desc}}">
                <StackPanel Spacing="8">
                    <m:Calendar
                        SelectionMode="Multiple"
                        SelectedDates="{Binding MultipleDates, Mode=TwoWay}" />
                    <TextBlock
                        Text="{Binding MultipleDatesText, StringFormat='Selected: {0}'}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </demo:GalleryBlock>

            <demo:GalleryBlock
                Classes="Origin"
                Title="{demo:Translate {x:Static demo:LanguageManager+Keys.Calendar_Range}}"
                Summary="{demo:Translate {x:Static demo:LanguageManager+Keys.Calendar_Range_Desc}}">
                <StackPanel Spacing="8">
                    <m:Calendar
                        SelectionMode="Range"
                        RangeStart="{Binding RangeStart, Mode=TwoWay}"
                        RangeEnd="{Binding RangeEnd, Mode=TwoWay}" />
                    <TextBlock
                        Text="{Binding RangeText, StringFormat='Range: {0}'}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </demo:GalleryBlock>

            <demo:GalleryBlock
                Classes="Origin"
                Title="{demo:Translate {x:Static demo:LanguageManager+Keys.Calendar_Scroll}}"
                Summary="{demo:Translate {x:Static demo:LanguageManager+Keys.Calendar_Scroll_Desc}}">
                <StackPanel Spacing="8">
                    <m:Calendar
                        DisplayMode="Scroll"
                        SelectionMode="Range"
                        RangeStart="{Binding ScrollRangeStart, Mode=TwoWay}"
                        RangeEnd="{Binding ScrollRangeEnd, Mode=TwoWay}" />
                    <TextBlock
                        Text="{Binding ScrollRangeText, StringFormat='Range: {0}'}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </demo:GalleryBlock>

            <demo:GalleryBlock
                Classes="Origin"
                Title="{demo:Translate {x:Static demo:LanguageManager+Keys.Calendar_ScrollPopup}}"
                Summary="{demo:Translate {x:Static demo:LanguageManager+Keys.Calendar_ScrollPopup_Desc}}">
                <m:CellGroup>
                    <m:Cell
                        Classes="Arrow"
                        Command="{Binding OpenScrollPopupCommand}"
                        Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Calendar_ScrollPopup_Cell}}"
                        Description="{demo:Translate {x:Static demo:LanguageManager+Keys.Calendar_ScrollPopup_CellDesc}}"
                        Note="{Binding PopupRangeText}" />
                </m:CellGroup>
            </demo:GalleryBlock>
        </StackPanel>

        <m:Popup
            IsOpen="{Binding IsScrollPopupOpen}"
            IsModal="True"
            IsLightDismissEnabled="True"
            Placement="Bottom"
            MinHeight="480">
            <Border
                Background="{DynamicResource TDBgColorContainer}"
                CornerRadius="16"
                Padding="16,16,16,24">
                <StackPanel Spacing="12">
                    <TextBlock
                        FontSize="20"
                        FontWeight="Bold"
                        Text="{demo:Translate {x:Static demo:LanguageManager+Keys.Calendar_ScrollPopup}}" />

                    <m:Calendar
                        DisplayMode="Scroll"
                        SelectionMode="Range"
                        RangeStart="{Binding PopupRangeStart, Mode=TwoWay}"
                        RangeEnd="{Binding PopupRangeEnd, Mode=TwoWay}" />

                    <TextBlock
                        Text="{Binding PopupRangeText, StringFormat='Range: {0}'}"
                        TextWrapping="Wrap" />

                    <Button
                        Classes="Primary"
                        Command="{Binding CloseScrollPopupCommand}"
                        Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Popup_Close}}" />
                </StackPanel>
            </Border>
        </m:Popup>
    </Panel>
</ContentPage>