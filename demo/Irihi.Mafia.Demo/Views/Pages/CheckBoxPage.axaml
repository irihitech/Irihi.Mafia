<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:demo="https://irihi.tech/demo"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="Irihi.Mafia.Demo.Views.CheckBoxPage"
             Theme="{DynamicResource ScrollPage}">
    <StackPanel Spacing="32">
        <demo:GalleryBlock
            Classes="PageStart"
            Title="{demo:Translate {x:Static demo:LanguageManager+Keys.CheckBox_Title}}"
            Summary="{demo:Translate {x:Static demo:LanguageManager+Keys.CheckBox_Desc}}" />

        <demo:GalleryBlock
            Classes="Origin"
            Title="{demo:Translate {x:Static demo:LanguageManager+Keys.CheckBox_Basic}}">
            <StackPanel>
                <CheckBox Content="{demo:Translate {x:Static demo:LanguageManager+Keys.CheckBox_Default}}" />
                <CheckBox Content="{demo:Translate {x:Static demo:LanguageManager+Keys.CheckBox_Checked}}" IsChecked="True" />
                <CheckBox Content="{demo:Translate {x:Static demo:LanguageManager+Keys.CheckBox_Indeterminate}}"
                          IsThreeState="True" IsChecked="{x:Null}" />
                <CheckBox Content="{demo:Translate {x:Static demo:LanguageManager+Keys.CheckBox_Justify}}"
                          Classes="Justify" IsChecked="True" />
            </StackPanel>
        </demo:GalleryBlock>

        <demo:GalleryBlock
            Classes="Origin"
            Title="{demo:Translate {x:Static demo:LanguageManager+Keys.CheckBox_States}}">
            <StackPanel>
                <CheckBox Content="{demo:Translate {x:Static demo:LanguageManager+Keys.CheckBox_DisabledChecked}}"
                          IsChecked="True" IsEnabled="False" />
                <CheckBox Content="{demo:Translate {x:Static demo:LanguageManager+Keys.CheckBox_Disabled}}"
                          IsEnabled="False" />
            </StackPanel>
        </demo:GalleryBlock>
    </StackPanel>
</ContentPage>