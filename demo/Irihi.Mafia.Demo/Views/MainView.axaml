<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Irihi.Mafia.Demo.ViewModels"
             xmlns:m="https://irihi.tech/mafia"
             mc:Ignorable="d" d:DesignWidth="375" d:DesignHeight="812"
             x:Class="Irihi.Mafia.Demo.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Panel>
        <ScrollViewer>
            <StackPanel Spacing="12" Margin="16">
                <TextBlock Text="Popup Demo" FontSize="24" FontWeight="Bold" Margin="0,8" />

                <TextBlock Text="Placement" FontSize="18" FontWeight="Bold" />
                <Button Content="Bottom" Command="{Binding OpenPopupCommand}" CommandParameter="Bottom" />
                <Button Content="Center" Command="{Binding OpenPopupCommand}" CommandParameter="Center" />
                <Button Content="Top" Command="{Binding OpenPopupCommand}" CommandParameter="Top" />
                <Button Content="Left" Command="{Binding OpenPopupCommand}" CommandParameter="Left" />
                <Button Content="Right" Command="{Binding OpenPopupCommand}" CommandParameter="Right" />
                <Button Content="FullScreen" Command="{Binding OpenPopupCommand}" CommandParameter="FullScreen" />

                <TextBlock Text="Options" FontSize="18" FontWeight="Bold" Margin="0,8,0,0" />
                <CheckBox Content="IsModal" IsChecked="{Binding IsModal}" />
                <CheckBox Content="Light Dismiss" IsChecked="{Binding IsLightDismiss}" />
            </StackPanel>
        </ScrollViewer>

        <m:Popup IsOpen="{Binding IsPopupOpen}"
                 IsModal="{Binding IsModal}"
                 IsLightDismissEnabled="{Binding IsLightDismiss}"
                 Placement="{Binding PopupPlacement}">
            <m:Popup.Child>
                <Border Background="{DynamicResource TDBgColorContainer}"
                        CornerRadius="12"
                        Padding="24"
                        MinHeight="200">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding PopupTitle}" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Click outside or press close to dismiss." TextWrapping="Wrap" />
                        <Button Content="Close"
                                Command="{Binding ClosePopupCommand}"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </m:Popup.Child>
        </m:Popup>
    </Panel>
</UserControl>
