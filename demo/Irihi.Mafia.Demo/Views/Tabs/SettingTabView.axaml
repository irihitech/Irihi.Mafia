<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:demo="https://irihi.tech/demo"
             xmlns:vm="using:Irihi.Mafia.Demo.ViewModels"
             xmlns:m="https://irihi.tech/mafia"
             xmlns:td="https://irihi.tech/td"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="Irihi.Mafia.Demo.Views.SettingTabView"
             x:DataType="vm:SettingTabViewModel"
             Theme="{DynamicResource ScrollPage}">
    <StackPanel>
        <Border Background="{DynamicResource TDBgColorContainer}" Padding="16,24,16,20">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                <Border Grid.Column="0" Background="{DynamicResource TDPrimaryColor}"
                        Width="64" Height="64" CornerRadius="32">
                    <m:Avatar Content="M" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="Mafia Demo" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="{demo:Translate {x:Static demo:LanguageManager+Keys.List_Online}}"
                               Foreground="{DynamicResource TDSuccessColor}" />
                </StackPanel>
            </Grid>
        </Border>

        <m:Divider />

        <m:CellGroup Header="{demo:Translate {x:Static demo:LanguageManager+Keys.List_Section_Display}}">
            <m:Picker ItemsSource="{Binding ThemeOptions}"
                      SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}"
                      Description="{demo:Translate {x:Static demo:LanguageManager+Keys.List_Theme_Description}}">
                <m:Picker.SelectionBoxItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding .^}" />
                    </DataTemplate>
                </m:Picker.SelectionBoxItemTemplate>
                <m:Picker.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding .^}" />
                    </DataTemplate>
                </m:Picker.ItemTemplate>
            </m:Picker>
            <m:Picker ItemsSource="{Binding LanguageOptions}"
                      SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}"
                      Description="{demo:Translate {x:Static demo:LanguageManager+Keys.List_Language_Description}}" />
        </m:CellGroup>

        <m:CellGroup Header="{demo:Translate {x:Static demo:LanguageManager+Keys.List_Section_About}}">
            <m:Cell Content="{demo:Translate {x:Static demo:LanguageManager+Keys.List_Version}}" Note="{Binding CurrentVersion}" />
            <m:Cell
                Classes="Arrow"
                Content="{demo:Translate {x:Static demo:LanguageManager+Keys.List_CheckUpdate}}"
                Command="{Binding CheckUpdateCommand}" />
            <m:Cell Content="{demo:Translate {x:Static demo:LanguageManager+Keys.List_License}}" Note="MIT" />
            <m:Cell Content="{demo:Translate {x:Static demo:LanguageManager+Keys.List_Project}}" Note="GitHub" Classes="Arrow"
                    Command="{Binding OpenProjectUrlCommand}" />
            <m:Cell Content="{demo:Translate {x:Static demo:LanguageManager+Keys.List_TechStack}}" Description="Avalonia 12 · .NET 10"
                    InnerLeftContent="{td:TempApp}" />
        </m:CellGroup>

        <m:Popup IsOpen="{Binding UpdatePopupState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:UpdatePopupState.Checking}}"
                 IsModal="True"
                 IsLightDismissEnabled="False"
                 Placement="Center">
            <Border Background="{DynamicResource TDBgColorContainer}"
                    CornerRadius="16"
                    Padding="24">
                <TextBlock Text="{demo:Translate {x:Static demo:LanguageManager+Keys.Update_Checking}}" />
            </Border>
        </m:Popup>

        <m:Popup IsOpen="{Binding UpdatePopupState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:UpdatePopupState.NewVersion}}"
                 IsModal="True"
                 IsLightDismissEnabled="False"
                 Placement="Bottom">
            <Border Background="{DynamicResource TDBgColorContainer}"
                    CornerRadius="16,16,0,0"
                    Padding="20,24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{demo:Translate {x:Static demo:LanguageManager+Keys.Update_Found_Title}}"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="Bold" />
                    <TextBlock HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap">
                        <Run Text="{demo:Translate {x:Static demo:LanguageManager+Keys.Update_Found_Message_Prefix}}" />
                        <Run Text="{Binding TargetVersion}" FontWeight="Bold" />
                        <Run Text="{demo:Translate {x:Static demo:LanguageManager+Keys.Update_Found_Message_Suffix}}" />
                    </TextBlock>
                    <UniformGrid Columns="2" ColumnSpacing="12">
                        <Button HorizontalAlignment="Stretch"
                                Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Update_Cancel}}"
                                Command="{Binding CancelUpdateCommand}" />
                        <Button Classes="Primary"
                                HorizontalAlignment="Stretch"
                                Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Update_Ok}}"
                                Command="{Binding ConfirmUpdateCommand}" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </m:Popup>

        <m:Popup IsOpen="{Binding UpdatePopupState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:UpdatePopupState.Downloading}}"
                 IsModal="True"
                 IsLightDismissEnabled="False"
                 Placement="Bottom">
            <Border Background="{DynamicResource TDBgColorContainer}"
                    CornerRadius="16,16,0,0"
                    Padding="20,24">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{demo:Translate {x:Static demo:LanguageManager+Keys.Update_Download_Title}}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <m:IconButton Grid.Column="1"
                                      Classes="Circle"
                                      Command="{Binding CancelUpdateCommand}">
                            <m:IconButton.Icon>
                                <td:TempClose />
                            </m:IconButton.Icon>
                        </m:IconButton>
                    </Grid>
                    <ProgressBar Value="{Binding Progress.ProgressPercentage}"
                                 Maximum="100" />
                    <TextBlock HorizontalAlignment="Center">
                        <Run Text="{demo:Translate {x:Static demo:LanguageManager+Keys.Update_Download_Speed_Prefix}}" />
                        <Run Text="{Binding Progress.SpeedMbPerSecond, StringFormat='{}{0:F2}'}" />
                        <Run Text=" MB/s" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </m:Popup>

        <m:Popup IsOpen="{Binding UpdatePopupState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:UpdatePopupState.ReadyToInstall}}"
                 IsModal="True"
                 IsLightDismissEnabled="False"
                 Placement="Bottom">
            <Border Background="{DynamicResource TDBgColorContainer}"
                    CornerRadius="16,16,0,0"
                    Padding="20,24">
                <StackPanel Spacing="16">
                    <td:TempCheck Width="40" Height="40" HorizontalAlignment="Center"
                                  Stroke1="{DynamicResource TDSuccessColor}" />
                    <TextBlock Text="{demo:Translate {x:Static demo:LanguageManager+Keys.Update_Install_Title}}"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center">
                        <Run Text="{demo:Translate {x:Static demo:LanguageManager+Keys.Update_Install_Message_Prefix}}" />
                        <Run Text="{Binding TargetVersion}" FontWeight="Bold" />
                        <Run Text="{demo:Translate {x:Static demo:LanguageManager+Keys.Update_Install_Message_Suffix}}" />
                    </TextBlock>
                    <UniformGrid Columns="2" ColumnSpacing="12">
                        <Button HorizontalAlignment="Stretch"
                                Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Update_Cancel}}"
                                Command="{Binding InstallCancelCommand}" />
                        <Button Classes="Primary"
                                HorizontalAlignment="Stretch"
                                Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Update_Ok}}"
                                Command="{Binding InstallConfirmCommand}" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </m:Popup>

        <m:Popup IsOpen="{Binding UpdatePopupState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:UpdatePopupState.Notice}}"
                 IsModal="True"
                 IsLightDismissEnabled="False"
                 Placement="Center">
            <Border Background="{DynamicResource TDBgColorContainer}"
                    CornerRadius="16"
                    Padding="20,24"
                    MaxWidth="280">
                <StackPanel Spacing="16">
                    <StackPanel IsVisible="{Binding IsLatestVersion}" Spacing="8">
                        <td:TempCheckCircle Width="40" Height="40" HorizontalAlignment="Center"
                                            Stroke1="{DynamicResource TDSuccessColor}" />
                        <TextBlock Text="{demo:Translate {x:Static demo:LanguageManager+Keys.Update_AlreadyLatest}}"
                                   FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding !IsLatestVersion}" Spacing="8">
                        <td:TempCloseCircle Width="40" Height="40" HorizontalAlignment="Center"
                                            Stroke1="{DynamicResource TDDangerColor}" />
                        <TextBlock Text="{Binding MessageText}"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                    <Button Classes="Primary"
                            Content="{demo:Translate {x:Static demo:LanguageManager+Keys.Update_Ok}}"
                            Command="{Binding CloseMessageCommand}"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </m:Popup>
    </StackPanel>
</ContentPage>