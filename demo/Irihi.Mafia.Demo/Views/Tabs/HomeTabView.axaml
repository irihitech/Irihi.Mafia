<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Irihi.Mafia.Demo"
             xmlns:vm="using:Irihi.Mafia.Demo.ViewModels"
             xmlns:m="https://irihi.tech/mafia"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="Irihi.Mafia.Demo.Views.HomeTabView"
             x:DataType="vm:HomeTabViewModel">
    <ScrollViewer>
        <StackPanel>
            <Border Background="{DynamicResource TDBgColorContainer}" Padding="16,12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" Background="{DynamicResource TDPrimaryColor}"
                            Width="48" Height="48" CornerRadius="24"
                            VerticalAlignment="Top">
                        <TextBlock Text="M" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TDTextColorPrimary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Translate {x:Static local:LanguageManager+Keys.Home_Title_Mafia}}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Translate {x:Static local:LanguageManager+Keys.Home_Subtitle_Welcome}}"
                                   TextWrapping="Wrap" FontSize="13"
                                   MaxHeight="36" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Translate {x:Static local:LanguageManager+Keys.Home_Timestamp_Now}}" FontSize="12"
                               VerticalAlignment="Top" />
                </Grid>
            </Border>

            <m:Divider Margin="72,0,0,0" />

            <Border Background="{DynamicResource TDBgColorContainer}" Padding="16,12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" Background="{DynamicResource TDWarningColor}"
                            Width="48" Height="48" CornerRadius="24"
                            VerticalAlignment="Top">
                        <TextBlock Text="∞" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TDTextColorAnti}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Translate {x:Static local:LanguageManager+Keys.Home_Title_CustomControls}}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Translate {x:Static local:LanguageManager+Keys.Home_Subtitle_Controls}}"
                                   TextWrapping="Wrap" FontSize="13"
                                   MaxHeight="36" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Translate {x:Static local:LanguageManager+Keys.Home_Timestamp_Yesterday}}" FontSize="12"
                               VerticalAlignment="Top" />
                </Grid>
            </Border>

            <m:Divider Margin="72,0,0,0" />

            <Border Background="{DynamicResource TDBgColorContainer}" Padding="16,12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" Background="{DynamicResource TDSuccessColor}"
                            Width="48" Height="48" CornerRadius="24"
                            VerticalAlignment="Top">
                        <TextBlock Text="🎨" FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Translate {x:Static local:LanguageManager+Keys.Home_Title_TDesign}}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Translate {x:Static local:LanguageManager+Keys.Home_Subtitle_TDesign}}"
                                   TextWrapping="Wrap" FontSize="13"
                                   MaxHeight="36" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="昨天" FontSize="12"
                               VerticalAlignment="Top" />
                </Grid>
            </Border>

            <m:Divider Margin="72,0,0,0" />

            <Border Background="{DynamicResource TDBgColorContainer}" Padding="16,12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" Background="{DynamicResource TDDangerColor}"
                            Width="48" Height="48" CornerRadius="24"
                            VerticalAlignment="Top">
                        <TextBlock Text="⬆" FontSize="22"
                                   Foreground="{DynamicResource TDTextColorPrimary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Translate {x:Static local:LanguageManager+Keys.Home_Title_Popup}}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Translate {x:Static local:LanguageManager+Keys.Home_Subtitle_Popup}}"
                                   TextWrapping="Wrap" FontSize="13"
                                   MaxHeight="36" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Translate {x:Static local:LanguageManager+Keys.Home_Timestamp_Wednesday}}" FontSize="12"
                               VerticalAlignment="Top" />
                </Grid>
            </Border>

            <m:Divider Margin="72,0,0,0" />

            <Border Background="{DynamicResource TDBgColorContainer}" Padding="16,12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" Background="{DynamicResource TDPrimaryColor}"
                            Width="48" Height="48" CornerRadius="24"
                            VerticalAlignment="Top">
                        <TextBlock Text="📱" FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Translate {x:Static local:LanguageManager+Keys.Home_Title_CrossPlatform}}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Translate {x:Static local:LanguageManager+Keys.Home_Subtitle_CrossPlatform}}"
                                   TextWrapping="Wrap" FontSize="13"
                                   MaxHeight="36" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Translate {x:Static local:LanguageManager+Keys.Home_Timestamp_Monday}}" FontSize="12"
                               VerticalAlignment="Top" />
                </Grid>
            </Border>

            <m:Divider Margin="72,0,0,0" />

            <Border Background="{DynamicResource TDBgColorContainer}" Padding="16,12"
                    Margin="0,0,0,24">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0"
                            Width="48" Height="48" CornerRadius="24"
                            VerticalAlignment="Top"
                            Opacity="0.3">
                        <TextBlock Text="ℹ" FontSize="22"
                                   Foreground="{DynamicResource TDTextColorPrimary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Translate {x:Static local:LanguageManager+Keys.Home_Title_About}}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Translate {x:Static local:LanguageManager+Keys.Home_Subtitle_About}}"
                                   TextWrapping="Wrap" FontSize="13"
                                   MaxHeight="36" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="" FontSize="12"
                               VerticalAlignment="Top" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentPage>