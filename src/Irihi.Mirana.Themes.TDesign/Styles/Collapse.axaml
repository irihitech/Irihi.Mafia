<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="https://irihi.tech/mirana">
    <!-- Remove bottom border from last CollapsePanel in a Collapse -->
    <Style Selector="m|Collapse m|CollapsePanel:nth-last-child(1) /template/ Border">
        <Setter Property="BorderThickness" Value="0" />
    </Style>
</Styles>
