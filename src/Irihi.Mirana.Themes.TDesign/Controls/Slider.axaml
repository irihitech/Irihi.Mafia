<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <StackPanel Margin="20" Spacing="30">
            <StackPanel Spacing="16">
                <TextBlock Text="Horizontal Slider" />
                <Slider Width="300" Minimum="0" Maximum="100" Value="50" />
                <Slider Width="300" Minimum="0" Maximum="100" Value="30" IsEnabled="False" />
            </StackPanel>
            <StackPanel Spacing="16">
                <TextBlock Text="Vertical Slider" />
                <Slider Height="200" Minimum="0" Maximum="100" Value="50" Orientation="Vertical" />
            </StackPanel>
        </StackPanel>
    </Design.PreviewWith>

    <!-- Horizontal RepeatButton Theme -->
    <ControlTheme x:Key="SliderHorizontalRepeatButton" TargetType="RepeatButton">
        <Setter Property="Template">
            <ControlTemplate TargetType="RepeatButton">
                <Grid>
                    <Border
                        Name="FocusTarget"
                        Margin="0,-10"
                        Background="Transparent" />
                    <Border
                        Name="TrackBackground"
                        Height="{DynamicResource TDSliderTrackHeight}"
                        Margin="{TemplateBinding Margin}"
                        VerticalAlignment="Center"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource TDSliderTrackCornerRadius}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- Vertical RepeatButton Theme -->
    <ControlTheme x:Key="SliderVerticalRepeatButton" TargetType="RepeatButton">
        <Setter Property="Template">
            <ControlTemplate TargetType="RepeatButton">
                <Grid>
                    <Border
                        Name="FocusTarget"
                        Margin="-10,0"
                        Background="Transparent" />
                    <Border
                        Name="TrackBackground"
                        Width="{DynamicResource TDSliderTrackHeight}"
                        Margin="{TemplateBinding Margin}"
                        HorizontalAlignment="Center"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource TDSliderTrackCornerRadius}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- Thumb Theme -->
    <ControlTheme x:Key="SliderThumbTheme" TargetType="Thumb">
        <Setter Property="CornerRadius" Value="{DynamicResource TDSliderThumbCornerRadius}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{DynamicResource TDSliderThumbBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TDSliderThumbBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource TDSliderThumbBorderThickness}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Thumb">
                <Border
                    Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource TDSliderThumbPointeroverBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TDSliderThumbPointeroverBorderBrush}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource TDSliderThumbPressedBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TDSliderThumbPressedBorderBrush}" />
        </Style>
    </ControlTheme>

    <!-- Main Slider Theme -->
    <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
        <Setter Property="Background" Value="{DynamicResource TDSliderTrackBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TDSliderTrackForeground}" />
        <Setter Property="BorderThickness" Value="0" />
        
        <!-- Horizontal Orientation -->
        <Style Selector="^:horizontal">
            <Setter Property="Template">
                <ControlTemplate TargetType="Slider">
                    <DataValidationErrors>
                        <Grid
                            Name="SliderContainer"
                            Margin="{TemplateBinding Padding}"
                            Background="Transparent">
                            <Track
                                Name="PART_Track"
                                IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                Maximum="{TemplateBinding Maximum}"
                                Minimum="{TemplateBinding Minimum}"
                                Orientation="Horizontal"
                                Value="{TemplateBinding Value, Mode=TwoWay}">
                                <Track.DecreaseButton>
                                    <RepeatButton
                                        Name="PART_DecreaseButton"
                                        Background="{TemplateBinding Foreground}"
                                        Focusable="False"
                                        Theme="{StaticResource SliderHorizontalRepeatButton}" />
                                </Track.DecreaseButton>
                                <Track.IncreaseButton>
                                    <RepeatButton
                                        Name="PART_IncreaseButton"
                                        Background="{TemplateBinding Background}"
                                        Focusable="False"
                                        Theme="{StaticResource SliderHorizontalRepeatButton}" />
                                </Track.IncreaseButton>
                                <Thumb
                                    Name="thumb"
                                    Width="{DynamicResource TDSliderThumbSize}"
                                    Height="{DynamicResource TDSliderThumbSize}"
                                    DataContext="{TemplateBinding Value}"
                                    Theme="{StaticResource SliderThumbTheme}" />
                            </Track>
                        </Grid>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Vertical Orientation -->
        <Style Selector="^:vertical">
            <Setter Property="Template">
                <ControlTemplate TargetType="Slider">
                    <DataValidationErrors>
                        <Grid
                            Name="SliderContainer"
                            Margin="{TemplateBinding Padding}"
                            Background="Transparent">
                            <Track
                                Name="PART_Track"
                                IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                Maximum="{TemplateBinding Maximum}"
                                Minimum="{TemplateBinding Minimum}"
                                Orientation="Vertical"
                                Value="{TemplateBinding Value, Mode=TwoWay}">
                                <Track.DecreaseButton>
                                    <RepeatButton
                                        Name="PART_DecreaseButton"
                                        Background="{TemplateBinding Foreground}"
                                        Focusable="False"
                                        Theme="{StaticResource SliderVerticalRepeatButton}" />
                                </Track.DecreaseButton>
                                <Track.IncreaseButton>
                                    <RepeatButton
                                        Name="PART_IncreaseButton"
                                        Background="{TemplateBinding Background}"
                                        Focusable="False"
                                        Theme="{StaticResource SliderVerticalRepeatButton}" />
                                </Track.IncreaseButton>
                                <Thumb
                                    Name="thumb"
                                    Width="{DynamicResource TDSliderThumbSize}"
                                    Height="{DynamicResource TDSliderThumbSize}"
                                    DataContext="{TemplateBinding Value}"
                                    Theme="{StaticResource SliderThumbTheme}" />
                            </Track>
                        </Grid>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Disabled State -->
        <Style Selector="^:disabled">
            <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
                <Setter Property="Background" Value="{DynamicResource TDSliderTrackDisabledForeground}" />
            </Style>
            <Style Selector="^ /template/ RepeatButton#PART_IncreaseButton">
                <Setter Property="Background" Value="{DynamicResource TDSliderTrackDisabledBackground}" />
            </Style>
            <Style Selector="^ /template/ Thumb">
                <Setter Property="Background" Value="{DynamicResource TDSliderThumbDisabledBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TDSliderThumbDisabledBorderBrush}" />
            </Style>
        </Style>
    </ControlTheme>

</ResourceDictionary>
