<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="https://irihi.tech/mirana">
    <Design.PreviewWith>
        <m:CellGroup Header="基础用法" Width="400" Margin="20">
            <m:Cell Content="单行标题" />
            <m:Cell Content="单行标题" Classes="Arrow" />
            <m:Cell Content="单行标题" Classes="Arrow" IsRequired="True" />
            <m:Cell Content="单行标题" Classes="Arrow" Note="辅助信息" />
            <m:Cell Content="单行标题" Classes="Arrow" />
            <m:Cell Content="单行标题" InnerLeftContent="{StaticResource Temporary}" />
            <m:Cell Content="单行标题" InnerRightContent="{StaticResource TDCellArrowGeometry}" />
            <m:Cell
                Classes="Arrow"
                Content="单行标题"
                Description="一段很长很长的内容文字"
                Note="辅助信息"
                InnerLeftContent="{StaticResource Temporary}" />
        </m:CellGroup>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type m:CellGroup}" TargetType="m:CellGroup">
        <Setter Property="BorderBrush" Value="{StaticResource TDCellGroupBorderColor}" />
        <Setter Property="BorderThickness" Value="0,1" />
        <Setter Property="Template">
            <ControlTemplate TargetType="m:CellGroup">
                <StackPanel>
                    <ContentPresenter
                        Padding="{StaticResource TDCellGroupTitlePaddingLeft},0,0,0"
                        FontSize="{StaticResource TDCellGroupTitleFontSize}"
                        LineHeight="{StaticResource TDCellGroupTitleLineHeight}"
                        Foreground="{StaticResource TDCellGroupTitleColor}"
                        Background="{StaticResource TDCellGroupTitleBgColor}"
                        Content="{TemplateBinding Header}"
                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                        IsVisible="{TemplateBinding Header, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Border
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Border>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type m:Cell}" TargetType="m:Cell">
        <Setter Property="Padding" Value="{StaticResource TDCellPadding}" />
        <Setter Property="Background" Value="{StaticResource TDCellBgColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource TDCellBorderColor}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate TargetType="m:Cell">
                <Border
                    Name="PART_Background"
                    Padding="{TemplateBinding Padding}"
                    MinHeight="{TemplateBinding MinHeight}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                    <Grid
                        Name="{x:Static m:Cell.PART_RootPanel}"
                        ColumnDefinitions="Auto,*,Auto">

                        <ContentPresenter
                            Grid.Column="0"
                            Name="PART_InnerLeftContent"
                            Margin="0,0,12,0"
                            Foreground="{StaticResource TDCellLeftIconColor}"
                            Content="{TemplateBinding InnerLeftContent}"
                            ContentTemplate="{TemplateBinding InnerLeftContentTemplate}"
                            IsVisible="{TemplateBinding InnerLeftContent, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ContentPresenter.DataTemplates>
                                <DataTemplate DataType="Geometry">
                                    <PathIcon Data="{Binding}" />
                                </DataTemplate>
                            </ContentPresenter.DataTemplates>
                        </ContentPresenter>

                        <StackPanel
                            Grid.Column="1"
                            Margin="0,0,16,0"
                            Spacing="{StaticResource TDCellContentSpacing}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ContentPresenter
                                    Name="PART_ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    TextElement.FontSize="{StaticResource TDCellTitleFont}"
                                    TextElement.Foreground="{StaticResource TDCellTitleColor}"
                                    IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock
                                    Foreground="{StaticResource TDCellRequiredColor}"
                                    IsVisible="{TemplateBinding IsRequired}"
                                    Text="*" />
                            </StackPanel>
                            <ContentPresenter
                                Name="PART_Description"
                                Content="{TemplateBinding Description}"
                                ContentTemplate="{TemplateBinding DescriptionTemplate}"
                                TextElement.FontSize="{StaticResource TDCellDescriptionFont}"
                                TextElement.Foreground="{StaticResource TDCellDescriptionColor}"
                                IsVisible="{TemplateBinding Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Name="PART_RightPanel"
                            Orientation="Horizontal"
                            Spacing="{StaticResource TDCellContentSpacing}"
                            VerticalAlignment="Center">
                            <ContentPresenter
                                Name="PART_Note"
                                Content="{TemplateBinding Note}"
                                ContentTemplate="{TemplateBinding NoteTemplate}"
                                TextElement.FontSize="{StaticResource TDCellNoteFont}"
                                TextElement.Foreground="{StaticResource TDCellNoteColor}"
                                IsVisible="{TemplateBinding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ContentPresenter
                                Name="PART_InnerRightContent"
                                Foreground="{StaticResource TDCellRightIconColor}"
                                Content="{TemplateBinding InnerRightContent}"
                                ContentTemplate="{TemplateBinding InnerRightContentTemplate}"
                                IsVisible="{Binding !!$self.Content}">
                                <ContentPresenter.DataTemplates>
                                    <DataTemplate DataType="Geometry">
                                        <PathIcon Data="{Binding}" />
                                    </DataTemplate>
                                </ContentPresenter.DataTemplates>
                            </ContentPresenter>
                        </StackPanel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^.Arrow /template/ ContentPresenter#PART_InnerRightContent">
            <Setter Property="Content" Value="{StaticResource TDCellArrowGeometry}" />
        </Style>
        <Style Selector="^.Hover:pressed /template/ Border#PART_Background">
            <Setter Property="Background" Value="{StaticResource TDCellHoverColor}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>