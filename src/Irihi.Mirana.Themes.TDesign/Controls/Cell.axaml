<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="https://irihi.tech/mirana">
    <Design.PreviewWith>
        <StackPanel Width="400">
            <m:Cell />
            <m:Cell Content="单行标题" />
            <m:Cell Content="单行标题" Classes="Arrow" />
            <m:Cell Content="单行标题" Classes="Arrow" IsRequired="True" />
            <m:Cell Content="单行标题" Classes="Arrow" Note="辅助信息" />
            <m:Cell Content="单行标题" Classes="Arrow" />
            <m:Cell Content="单行标题" InnerLeftContent="{StaticResource Temporary}" />
            <m:Cell Content="单行标题" InnerRightContent="{StaticResource TDCellArrowGeometry}" />
            <m:Cell
                Classes="Arrow"
                Content="单行标题"
                Description="一段很长很长的内容文字"
                Note="辅助信息"
                InnerLeftContent="{StaticResource Temporary}" />
        </StackPanel>
    </Design.PreviewWith>

    <!-- Resources -->
    <Thickness x:Key="TDCellPadding">16,14</Thickness>
    <Thickness x:Key="TDCellInnerSpacing">12</Thickness>
    <x:Double x:Key="TDCellContentNoteSpacing">8</x:Double>
    <x:Double x:Key="TDCellContentSpacing">4</x:Double>
    <x:Double x:Key="TDCellImageSize">48</x:Double>
    <x:Double x:Key="TDCellIconSize">24</x:Double>
    <x:Double x:Key="TDCellMinHeight">56</x:Double>

    <!-- Arrow Icon Geometry -->
    <StreamGeometry x:Key="TDCellArrowGeometry">M9 6L15 12L9 18</StreamGeometry>

    <ControlTheme x:Key="{x:Type m:Cell}" TargetType="m:Cell">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="{DynamicResource TDCellPadding}" />
        <Setter Property="Background" Value="{DynamicResource TDBgColorContainer}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TDComponentBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate TargetType="m:Cell">
                <Border
                    Name="PART_Background"
                    Padding="{TemplateBinding Padding}"
                    MinHeight="{TemplateBinding MinHeight}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                    <Grid
                        Name="{x:Static m:Cell.PART_RootPanel}"
                        ColumnDefinitions="Auto,*,Auto">

                        <ContentPresenter
                            Grid.Column="0"
                            Name="PART_InnerLeftContent"
                            Margin="0,0,12,0"
                            Content="{TemplateBinding InnerLeftContent}"
                            ContentTemplate="{TemplateBinding InnerLeftContentTemplate}"
                            IsVisible="{TemplateBinding InnerLeftContent, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ContentPresenter.DataTemplates>
                                <DataTemplate DataType="Geometry">
                                    <PathIcon Data="{Binding}" />
                                </DataTemplate>
                            </ContentPresenter.DataTemplates>
                        </ContentPresenter>

                        <StackPanel
                            Grid.Column="1"
                            Margin="0,0,16,0"
                            Spacing="{DynamicResource TDCellContentSpacing}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ContentPresenter
                                    Name="PART_ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    TextElement.FontSize="{DynamicResource TDFontSizeBodyLarge}"
                                    TextElement.Foreground="{DynamicResource TDTextColorPrimary}"
                                    IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock
                                    Foreground="{DynamicResource TDErrorColor6}"
                                    IsVisible="{TemplateBinding IsRequired}"
                                    Text="*" />
                            </StackPanel>
                            <ContentPresenter
                                Name="PART_Description"
                                Content="{TemplateBinding Description}"
                                ContentTemplate="{TemplateBinding DescriptionTemplate}"
                                TextElement.FontSize="{DynamicResource TDFontSizeBodyMedium}"
                                TextElement.Foreground="{DynamicResource TDTextColorSecondary}"
                                IsVisible="{TemplateBinding Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Name="PART_RightPanel"
                            Orientation="Horizontal"
                            Spacing="{DynamicResource TDCellContentSpacing}"
                            VerticalAlignment="Center">
                            <ContentPresenter
                                Name="PART_Note"
                                Content="{TemplateBinding Note}"
                                ContentTemplate="{TemplateBinding NoteTemplate}"
                                TextElement.FontSize="{DynamicResource TDFontSizeBodyMedium}"
                                TextElement.Foreground="{DynamicResource TDTextColorSecondary}"
                                IsVisible="{TemplateBinding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ContentPresenter
                                Name="PART_InnerRightContent"
                                Content="{TemplateBinding InnerRightContent}"
                                ContentTemplate="{TemplateBinding InnerRightContentTemplate}"
                                IsVisible="{Binding !!$self.Content}">
                                <ContentPresenter.DataTemplates>
                                    <DataTemplate DataType="Geometry">
                                        <PathIcon Data="{Binding}" />
                                    </DataTemplate>
                                </ContentPresenter.DataTemplates>
                            </ContentPresenter>
                        </StackPanel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^.Arrow /template/ ContentPresenter#PART_InnerRightContent">
            <Setter Property="Content" Value="{DynamicResource TDCellArrowGeometry}" />
        </Style>
        <Style Selector="^.Hover:pressed /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource TDBgColorContainerActive}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>