<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="https://irihi.tech/mirana">
    <Design.PreviewWith>
        <StackPanel Width="400">
            <m:Cell Content="单元格标题" />
            <m:Cell Content="单元格标题" Description="描述信息" />
            <m:Cell Content="单元格标题" Note="说明文字" />
            <m:Cell Content="单元格标题" Classes="arrow" />
            <m:Cell Content="单元格标题" InnerLeftContent="{StaticResource Temporary}" />
            <m:Cell Content="单元格标题" Image="{StaticResource Temporary}" />
            <m:Cell Content="单元格标题" InnerRightContent="{StaticResource Temporary}" />
            <m:Cell Content="单元格标题" Classes="required" />
            <m:Cell
                Content="单元格标题"
                Description="描述信息"
                Note="说明"
                InnerLeftContent="{StaticResource Temporary}"
                Classes="arrow Bordered" />
        </StackPanel>
    </Design.PreviewWith>

    <!-- Resources -->
    <Thickness x:Key="TDCellPadding">16,14</Thickness>
    <Thickness x:Key="TDCellInnerSpacing">12</Thickness>
    <x:Double x:Key="TDCellContentNoteSpacing">8</x:Double>
    <x:Double x:Key="TDCellContentSpacing">4</x:Double>
    <x:Double x:Key="TDCellImageSize">48</x:Double>
    <x:Double x:Key="TDCellIconSize">24</x:Double>
    <x:Double x:Key="TDCellMinHeight">56</x:Double>

    <!-- Arrow Icon Geometry -->
    <StreamGeometry x:Key="TDCellArrowGeometry">M9 6L15 12L9 18</StreamGeometry>

    <ControlTemplate x:Key="CellTemplate" TargetType="m:Cell">
        <Border
            Name="PART_Background"
            Padding="{TemplateBinding Padding}"
            MinHeight="{DynamicResource TDCellMinHeight}"
            Background="{DynamicResource TDBgColorContainer}"
            BorderBrush="{DynamicResource TDComponentBorder}">

            <Grid Name="{x:Static m:Cell.PART_RootPanel}" ColumnDefinitions="Auto,*,Auto">
                <!-- Left Side: Image or Left Icon -->
                <Panel Grid.Column="0" Margin="0,0,12,0">
                    <ContentPresenter
                        Name="PART_Image"
                        Content="{TemplateBinding Image}"
                        ContentTemplate="{TemplateBinding ImageTemplate}"
                        Width="{DynamicResource TDCellImageSize}"
                        Height="{DynamicResource TDCellImageSize}"
                        VerticalAlignment="Center"
                        IsVisible="{TemplateBinding Image, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ContentPresenter.DataTemplates>
                            <DataTemplate DataType="Geometry">
                                <PathIcon Data="{Binding}"
                                          Width="{DynamicResource TDCellImageSize}"
                                          Height="{DynamicResource TDCellImageSize}" />
                            </DataTemplate>
                        </ContentPresenter.DataTemplates>
                    </ContentPresenter>

                    <ContentPresenter
                        Name="PART_InnerLeftContent"
                        Content="{TemplateBinding InnerLeftContent}"
                        ContentTemplate="{TemplateBinding InnerLeftContentTemplate}"
                        Width="{DynamicResource TDCellIconSize}"
                        Height="{DynamicResource TDCellIconSize}"
                        VerticalAlignment="Center">
                        <ContentPresenter.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <TemplateBinding Property="Image" Converter="{x:Static ObjectConverters.IsNull}" />
                                <TemplateBinding Property="InnerLeftContent" Converter="{x:Static ObjectConverters.IsNotNull}" />
                            </MultiBinding>
                        </ContentPresenter.IsVisible>
                        <ContentPresenter.DataTemplates>
                            <DataTemplate DataType="Geometry">
                                <PathIcon Data="{Binding}"
                                          Width="{DynamicResource TDCellIconSize}"
                                          Height="{DynamicResource TDCellIconSize}" />
                            </DataTemplate>
                        </ContentPresenter.DataTemplates>
                    </ContentPresenter>
                </Panel>

                <!-- Center: Content, Description -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{DynamicResource TDCellContentSpacing}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource TDCellContentNoteSpacing}">
                        <!-- <TextBlock  -->
                        <!--     Text="*"  -->
                        <!--     Foreground="{DynamicResource TDErrorColor6}" -->
                        <!--     VerticalAlignment="Center" -->
                        <!--     IsVisible="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(m:Cell.Classes)[required]}" /> -->

                        <ContentPresenter
                            Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center"
                            TextElement.FontSize="{DynamicResource TDFontSizeBodyLarge}"
                            TextElement.FontWeight="Medium"
                            TextElement.Foreground="{DynamicResource TDTextColorPrimary}"
                            IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <ContentPresenter
                            Name="PART_Description"
                            Content="{TemplateBinding Description}"
                            ContentTemplate="{TemplateBinding DescriptionTemplate}"
                            VerticalAlignment="Center"
                            TextElement.FontSize="{DynamicResource TDFontSizeBodyMedium}"
                            TextElement.Foreground="{DynamicResource TDTextColorSecondary}"
                            IsVisible="{TemplateBinding Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>

                </StackPanel>

                <!-- Right Side: Note, Right Icon, Arrow -->
                <StackPanel Grid.Column="2"
                            Name="PART_RightPanel"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <ContentPresenter
                        Name="PART_Note"
                        Content="{TemplateBinding Note}"
                        ContentTemplate="{TemplateBinding NoteTemplate}"
                        TextElement.FontSize="{DynamicResource TDFontSizeBodyMedium}"
                        TextElement.Foreground="{DynamicResource TDTextColorSecondary}"
                        IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ContentPresenter.DataTemplates>
                            <DataTemplate DataType="Geometry">
                                <PathIcon Data="{Binding}" />
                            </DataTemplate>
                        </ContentPresenter.DataTemplates>
                    </ContentPresenter>

                    <ContentPresenter
                        Name="PART_InnerRightContent"
                        Content="{TemplateBinding InnerRightContent}"
                        ContentTemplate="{TemplateBinding InnerRightContentTemplate}"
                        Width="{DynamicResource TDCellIconSize}"
                        Height="{DynamicResource TDCellIconSize}"
                        IsVisible="{TemplateBinding InnerRightContent, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ContentPresenter.DataTemplates>
                            <DataTemplate DataType="Geometry">
                                <PathIcon Data="{Binding}"
                                          Width="{DynamicResource TDCellIconSize}"
                                          Height="{DynamicResource TDCellIconSize}" />
                            </DataTemplate>
                        </ContentPresenter.DataTemplates>
                    </ContentPresenter>
                </StackPanel>
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTheme x:Key="{x:Type m:Cell}" TargetType="m:Cell">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="{DynamicResource TDCellPadding}" />
        <Setter Property="Background" Value="{DynamicResource TDBgColorContainer}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TDComponentBorder}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{DynamicResource CellTemplate}" />

        <Style Selector="^.Bordered /template/ Border#PART_Background">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="^.Arrow /template/ ContentPresenter#PART_InnerRightContent">
            <Setter Property="Content" Value="{StaticResource TDCellArrowGeometry}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource TDBgColorContainerHover}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource TDBgColorContainerActive}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
    </ControlTheme>
</ResourceDictionary>