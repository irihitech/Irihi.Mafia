<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Track Dimensions -->
    <x:Double x:Key="TDSliderTrackHeight">4</x:Double>
    <StaticResource x:Key="TDSliderTrackCornerRadius" ResourceKey="TDRadiusRound" />

    <!-- Thumb Dimensions -->
    <x:Double x:Key="TDSliderThumbSize">18</x:Double>
    <Thickness x:Key="TDSliderThumbMargin">1,0,1,2</Thickness>
    <StaticResource x:Key="TDSliderThumbCornerRadius" ResourceKey="TDRadiusRound" />
    <Thickness x:Key="TDSliderThumbBorderThickness">1</Thickness>

</ResourceDictionary>
