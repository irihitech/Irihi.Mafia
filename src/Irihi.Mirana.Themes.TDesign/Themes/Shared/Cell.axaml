<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Thickness x:Key="TDCellGroupBorderThickness">0,1</Thickness>
    <x:Double x:Key="TDCellGroupHeaderFontSize">14</x:Double>
    <x:Double x:Key="TDCellGroupHeaderLineHeight">45</x:Double>
    <Thickness x:Key="TDCellGroupHeaderPadding">16,0,0,0</Thickness>

    <Thickness x:Key="TDCellPadding">16</Thickness>
    <Thickness x:Key="TDCellBorderThickness">0,0,0,1</Thickness>
    <Thickness x:Key="TDCellLeftContentMargin">0,0,12,0</Thickness>
    <Thickness x:Key="TDCellContentMargin">0,0,16,0</Thickness>
    <x:Double x:Key="TDCellContentPanelSpacing">4</x:Double>
    <x:Double x:Key="TDCellContentSpacing">4</x:Double>
    <x:Double x:Key="TDCellRightPanelSpacing">4</x:Double>
    <StaticResource x:Key="TDCellContentFontSize" ResourceKey="TDFontSizeBodyLarge" />
    <StaticResource x:Key="TDCellNoteFontSize" ResourceKey="TDFontSizeBodyMedium" />
    <StaticResource x:Key="TDCellDescriptionFontSize" ResourceKey="TDFontSizeBodyMedium" />
    <StaticResource x:Key="TDCellAsteriskFontSize" ResourceKey="TDFontSizeBodyMedium" />
</ResourceDictionary>