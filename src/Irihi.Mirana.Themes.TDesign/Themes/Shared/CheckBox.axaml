<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- CheckBox Tokens -->
    <x:Double x:Key="TDCheckBoxIconSize">24</x:Double>
    <x:Double x:Key="TDCheckBoxMinHeight">48</x:Double>
    <StaticResource x:Key="TDCheckBoxTitleFontSize" ResourceKey="TDFontSizeBodyLarge" />
    <Thickness x:Key="TDCheckBoxPadding">16</Thickness>
    <Thickness x:Key="TDCheckBoxContentMargin">8,0,0,0</Thickness>
    <Thickness x:Key="TDCheckBoxIconMargin">0,0,0,0</Thickness>
    <Thickness x:Key="TDCheckBoxIconBorderThickness">1</Thickness>
    <CornerRadius x:Key="TDCheckBoxIconCornerRadius">3</CornerRadius>
    <Thickness x:Key="TDCheckBoxBorderThickness">0,0,0,1</Thickness>
    
    <!-- CheckBox Card Tokens -->
    <Thickness x:Key="TDCheckBoxCardPadding">12</Thickness>
    <Thickness x:Key="TDCheckBoxCardBorderThickness">1</Thickness>
    <CornerRadius x:Key="TDCheckBoxCardCornerRadius">6</CornerRadius>

</ResourceDictionary>
