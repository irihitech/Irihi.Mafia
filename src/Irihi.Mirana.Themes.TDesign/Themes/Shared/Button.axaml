<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StaticResource x:Key="TDButtonRectangleBorderRadius" ResourceKey="TDRadiusDefault" />
    <StaticResource x:Key="TDButtonRoundBorderRadius" ResourceKey="TDRadiusRound" />

    <Thickness x:Key="TDButtonBorderThickness">1</Thickness>
    <FontWeight x:Key="TDButtonFontWeight">600</FontWeight>

    <x:Double x:Key="TDButtonLargeMinHeight">48</x:Double>
    <StaticResource x:Key="TDButtonLargeFontSize" ResourceKey="TDFontSizeBodyLarge" />
    <Thickness x:Key="TDButtonLargePaddingHorizontal">20,0</Thickness>

    <x:Double x:Key="TDButtonMediumMinHeight">40</x:Double>
    <StaticResource x:Key="TDButtonMediumFontSize" ResourceKey="TDFontSizeBodyLarge" />
    <Thickness x:Key="TDButtonMediumPaddingHorizontal">16,0</Thickness>

    <x:Double x:Key="TDButtonSmallMinHeight">32</x:Double>
    <StaticResource x:Key="TDButtonSmallFontSize" ResourceKey="TDFontSizeBodyMedium" />
    <Thickness x:Key="TDButtonSmallPaddingHorizontal">12,0</Thickness>

    <x:Double x:Key="TDButtonExtraSmallMinHeight">28</x:Double>
    <StaticResource x:Key="TDButtonExtraSmallFontSize" ResourceKey="TDFontSizeBodyMedium" />
    <Thickness x:Key="TDButtonExtraSmallPaddingHorizontal">8,0</Thickness>

    <x:Double x:Key="TDIconButtonInnerSpacing">4</x:Double>

    <StreamGeometry x:Key="Temporary">
        M3 3H10V10H3V3ZM14 14H21V21H14V14ZM3 14H10V21H3V14Z
        M21.5 6.5C21.5 8.70914 19.7091 10.5 17.5 10.5C15.2909 10.5 13.5 8.70914 13.5 6.5C13.5 4.29086 15.2909 2.5 17.5 2.5C19.7091 2.5 21.5 4.29086 21.5 6.5Z
    </StreamGeometry>
</ResourceDictionary>