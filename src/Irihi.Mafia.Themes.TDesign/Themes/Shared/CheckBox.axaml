<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="TDCheckBoxIconSize">24</x:Double>
    <x:Double x:Key="TDCheckBoxMinHeight">48</x:Double>
    <StaticResource x:Key="TDCheckBoxTitleFontSize" ResourceKey="TDFontSizeBodyLarge" />
    <Thickness x:Key="TDCheckBoxPadding">16</Thickness>
    <Thickness x:Key="TDCheckBoxContentMargin">8,0,0,0</Thickness>
    <x:Double x:Key="TDCheckBoxIconBorderThickness">1</x:Double>
    <Thickness x:Key="TDCheckBoxBorderThickness">0,0,0,1</Thickness>
</ResourceDictionary>
