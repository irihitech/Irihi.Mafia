<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StaticResource x:Key="TDProgressBorderRadius" ResourceKey="TDRadiusRound" />
    <x:Double x:Key="TDProgressDefaultHeight">6</x:Double>
    <x:Double x:Key="TDProgressLineFontSize">16</x:Double>
    <StaticResource x:Key="TDProgressInfoSpacing" ResourceKey="TDSize4" />

    <x:Double x:Key="TDProgressPlumpHeight">20</x:Double>
    <Thickness x:Key="TDProgressPlumpHorizontalTextMargin">8,0</Thickness>
    <Thickness x:Key="TDProgressPlumpVerticalTextMargin">0,8</Thickness>

    <x:Double x:Key="TDProgressCircleDefaultSize">112</x:Double>
    <x:Double x:Key="TDProgressCircleMicroSize">24</x:Double>
    <Thickness x:Key="TDProgressCircleDefaultStrokeWidth">6</Thickness>
    <Thickness x:Key="TDProgressCircleMicroStrokeWidth">2</Thickness>
    <StaticResource x:Key="TDProgressCircleFontSize" ResourceKey="TDFontSizeTitleExtraLarge" />
    <FontWeight x:Key="TDProgressCircleFontWeight">600</FontWeight>

</ResourceDictionary>