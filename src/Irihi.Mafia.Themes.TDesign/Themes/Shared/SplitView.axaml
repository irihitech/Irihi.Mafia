<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="TDSplitViewOpenPaneLength">280</x:Double>
    <x:Double x:Key="TDSplitViewCompactPaneLength">56</x:Double>
    <x:Double x:Key="TDSplitViewSeparatorThickness">1</x:Double>

    <x:TimeSpan x:Key="TDSplitViewPaneAnimationOpenDuration">00:00:00.2</x:TimeSpan>
    <x:TimeSpan x:Key="TDSplitViewPaneAnimationCloseDuration">00:00:00.1</x:TimeSpan>
    <Easing x:Key="TDSplitViewPaneAnimationEasing">0.1,0.9,0.2,1.0</Easing>
</ResourceDictionary>
