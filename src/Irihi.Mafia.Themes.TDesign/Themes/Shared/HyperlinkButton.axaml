<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="TDLinkIconSpacing">4</x:Double>
    <x:Double x:Key="TDLinkIconWidth">16</x:Double>
    <StaticResource x:Key="TDLinkSmallFontSize" ResourceKey="TDFontSizeLinkSmall" />
    <StaticResource x:Key="TDLinkMediumFontSize" ResourceKey="TDFontSizeLinkMedium" />
    <StaticResource x:Key="TDLinkLargeFontSize" ResourceKey="TDFontSizeLinkLarge" />
    <x:Double x:Key="TDLinkSmallIconWidth">12</x:Double>
    <x:Double x:Key="TDLinkMediumIconWidth">16</x:Double>
    <x:Double x:Key="TDLinkLargeIconWidth">18</x:Double>
</ResourceDictionary>
