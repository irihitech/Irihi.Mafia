<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Thickness x:Key="TDTabbedPageTabStripPadding">12,8</Thickness>
    <Thickness x:Key="TDTabbedPageTabStripBorderThickness">1</Thickness>

    <StaticResource x:Key="TDTabbedPageTabItemFontSize" ResourceKey="TDFontSizeBodyLarge" />
    <x:Double x:Key="TDTabbedPageTabItemWithIconFontSize">10</x:Double>
    <FontWeight x:Key="TDTabbedPageTabItemFontWeight">400</FontWeight>
    <FontWeight x:Key="TDTabbedPageTabItemSelectedFontWeight">600</FontWeight>
    <Thickness x:Key="TDTabbedPageTabItemPadding">10,6</Thickness>
    <StaticResource x:Key="TDTabbedPageTabItemCornerRadius" ResourceKey="TDRadiusRound" />
    <x:Double x:Key="TDTabbedPageTabItemMinHeight">40</x:Double>
    <x:Double x:Key="TDTabbedPageTabItemSpacing">2</x:Double>
    <x:Double x:Key="TDTabbedPageTabItemIconSize">20</x:Double>
</ResourceDictionary>
