<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StaticResource x:Key="TDInputFontSize" ResourceKey="TDFontSizeBodyLarge" />

    <x:Double x:Key="TDInputMinHeight">48</x:Double>

    <x:Double x:Key="TDInputLabelMaxWidth">80</x:Double>
    <x:Double x:Key="TDInputLabelMinWidth">32</x:Double>

    <x:Double x:Key="TDInputDescriptionFontSize">12</x:Double>
    <Thickness x:Key="TDInputDescriptionMargin">0,4,0,0</Thickness>

    <Thickness x:Key="TDInputPadding">16</Thickness>

    <Thickness x:Key="TDInputInnerButtonMargin">12,0,0,0</Thickness>
    <Thickness x:Key="TDInputInnerLeftContentPadding">0,0,16,0</Thickness>
    <Thickness x:Key="TDInputInnerRightContentPadding">12,0,0,0</Thickness>

    <Thickness x:Key="TDInputBorderThickness">0,0,0,1</Thickness>
</ResourceDictionary>
