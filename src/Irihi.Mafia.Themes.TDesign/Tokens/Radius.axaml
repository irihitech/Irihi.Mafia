<ResourceDictionary
    x:Class="Irihi.Mafia.Themes.TDesign.Tokens.Radius"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Border Radius -->
    <CornerRadius x:Key="TDRadiusSmall">2</CornerRadius>
    <CornerRadius x:Key="TDRadiusDefault">3</CornerRadius>
    <CornerRadius x:Key="TDRadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="TDRadiusLarge">9</CornerRadius>
    <CornerRadius x:Key="TDRadiusExtraLarge">12</CornerRadius>
    <CornerRadius x:Key="TDRadiusRound">999</CornerRadius>

</ResourceDictionary>
