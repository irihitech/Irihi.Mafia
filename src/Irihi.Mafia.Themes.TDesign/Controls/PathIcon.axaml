<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme x:Key="{x:Type PathIcon}" TargetType="PathIcon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate TargetType="PathIcon">
                <Viewbox
                    Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}">
                    <Path
                        Width="24"
                        Height="24"
                        Stroke="{TemplateBinding Foreground}"
                        StrokeThickness="{Binding BorderThickness.Left,RelativeSource={RelativeSource TemplatedParent}}"
                        Data="{TemplateBinding Data}"
                        Fill="{TemplateBinding Background}" />
                </Viewbox>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme
        x:Key="CirclePathIcon"
        BasedOn="{StaticResource {x:Type PathIcon}}"
        TargetType="PathIcon">
        <Setter Property="Template">
            <ControlTemplate TargetType="PathIcon">
                <Viewbox
                    Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}">
                    <Panel>
                        <Path
                            Width="24"
                            Height="24"
                            Stroke="{TemplateBinding Foreground}"
                            StrokeThickness="{Binding BorderThickness.Left,RelativeSource={RelativeSource TemplatedParent}}"
                            Data="M2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12Z"
                            Fill="{TemplateBinding Background}" />
                        <Path
                            Width="24"
                            Height="24"
                            Stroke="{TemplateBinding Foreground}"
                            StrokeThickness="{Binding BorderThickness.Left,RelativeSource={RelativeSource TemplatedParent}}"
                            Data="{TemplateBinding Data}"
                            Fill="{TemplateBinding Background}" />
                    </Panel>
                </Viewbox>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
