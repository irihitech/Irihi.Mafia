<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <StackPanel Margin="20">
            <PathIcon>
                <PathIcon.Data>
                    <StreamGeometry>
                        M11.6762 6.99023L13.9998 4.6666C15.4726 3.19382 17.8604 3.19382 19.3332 4.6666C20.806 6.13938 20.806 8.52723 19.3332 10L17.0096 12.3236M6.98974 11.6766L4.66611 14.0003C3.19333 15.4731 3.19333 17.8609 4.66611 19.3337C6.13889 20.8065 8.52675 20.8065 9.99953 19.3337L12.3232 17.0101M13.9985 9.99989L9.99847 14                    </StreamGeometry>
                </PathIcon.Data>
            </PathIcon>
            <PathIcon
                Theme="{DynamicResource CirclePathIcon}"
                Data="{DynamicResource TempMinusCircleGlyph}">
            </PathIcon>
        </StackPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type PathIcon}" TargetType="PathIcon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate TargetType="PathIcon">
                <Viewbox
                    Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}">
                    <Path
                        Width="24"
                        Height="24"
                        Stroke="{TemplateBinding Foreground}"
                        StrokeLineCap="Round"
                        StrokeThickness="{Binding BorderThickness.Left,RelativeSource={RelativeSource TemplatedParent}}"
                        Data="{TemplateBinding Data}"
                        Fill="{TemplateBinding Background}" />
                </Viewbox>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
