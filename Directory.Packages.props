<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AvaloniaVersion>12.0.3</AvaloniaVersion>
  </PropertyGroup>
  <ItemGroup>
    <!--src-->
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)"/>
    <PackageVersion Include="Irihi.Avalonia.Shared" Version="0.5.0"/>
    <!--test-->
    <PackageVersion Include="Avalonia.HarfBuzz" Version="$(AvaloniaVersion)"/>
    <PackageVersion Include="Avalonia.Headless.Xunit" Version="$(AvaloniaVersion)"/>
    <PackageVersion Include="coverlet.collector" Version="8.0.1"/>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.3.0"/>
    <PackageVersion Include="xunit.v3" Version="3.2.2"/>
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5"/>
    <!--demo-->
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)"/>
    <PackageVersion Include="Avalonia.iOS" Version="$(AvaloniaVersion)"/>
    <PackageVersion Include="Avalonia.Browser" Version="$(AvaloniaVersion)"/>
    <PackageVersion Include="Avalonia.Android" Version="$(AvaloniaVersion)"/>
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3"/>
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.2"/>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
    <PackageVersion Include="Irihi.Lingua" Version="1.0.0"/>
    <PackageVersion Include="Semi.Avalonia" Version="12.0.3"/>
  </ItemGroup>
</Project>
